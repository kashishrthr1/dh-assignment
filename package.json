{
  "name": "digital-heroes",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Heroes - Subscription golf tracking, charity fundraising, and monthly prize draws (MERN Stack)",
  "workspaces": [
    "server",
    "client"
  ],
  "allowScripts": {
    "esbuild": true,
    "core-js": true
  },
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "test:server": "npm --prefix server run test",
    "seed": "npm --prefix server run seed"
  }
}
